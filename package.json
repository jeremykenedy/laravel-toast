{
  "name": "laravel-toast-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:browser": "npm run build:test-css && playwright test",
    "screenshots": "npm run build:test-css && node scripts/capture-screenshots.mjs",
    "build:test-css": "tailwindcss -i tests/Browser/tailwind.css -o tests/Browser/tailwind.generated.css --minify"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/cli": "^4.1.0",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.6",
    "bootstrap4": "npm:bootstrap@^4.6.2",
    "bootstrap5": "npm:bootstrap@^5.3.3",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.0"
  }
}
