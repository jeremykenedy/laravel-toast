<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Laravel Toast">
    <description>PSR checks aligned with Laravel Pint and StyleCI, which own operator spacing, line wrapping, array formatting and docblock alignment.</description>
    <file>src</file>
    <file>config</file>
    <file>routes</file>
    <file>tests</file>
    <arg name="extensions" value="php"/>
    <exclude-pattern>*/resources/*</exclude-pattern>
    <exclude-pattern>*/tests/Browser/*</exclude-pattern>
    <exclude-pattern>*.blade.php</exclude-pattern>
    <rule ref="PSR12">
        <exclude name="PSR12.Operators.OperatorSpacing"/>
        <exclude name="PSR12.ControlStructures.ControlStructureSpacing"/>
        <exclude name="PSR12.Classes.AnonClassDeclaration"/>
        <exclude name="PSR12.Files.FileHeader"/>
        <exclude name="Generic.Files.LineLength"/>
    </rule>
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>*/src/helpers.php</exclude-pattern>
    </rule>
</ruleset>
