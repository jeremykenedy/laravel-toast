<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Laravel Toast">
    <description>Analyze package PHP while allowing Laravel facades and the package's stateless support classes.</description>
    <exclude-pattern>*/resources/views/*</exclude-pattern>
    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess"/>
    </rule>
    <rule ref="rulesets/cleancode.xml/StaticAccess">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
        <properties>
            <property name="exceptions" value="
                Illuminate\Support\Arr,Illuminate\Support\Str,Illuminate\Support\Js,
                Illuminate\Validation\Rule,
                Illuminate\Support\Facades\Blade,Illuminate\Support\Facades\Cache,
                Illuminate\Support\Facades\Event,Illuminate\Support\Facades\File,
                Illuminate\Support\Facades\Gate,Illuminate\Support\Facades\Route,
                Illuminate\Support\Facades\Schema,Illuminate\Support\Facades\Session,
                Illuminate\Support\Facades\Auth,
                Livewire\Livewire,
                Jeremykenedy\LaravelToast\Facades\Toast,
                Jeremykenedy\LaravelToast\Models\ToastSetting,
                Jeremykenedy\LaravelToast\Providers\ToastServiceProvider,
                Jeremykenedy\LaravelToast\Support\ToastAnimations,
                Jeremykenedy\LaravelToast\Support\ToastColors,
                Jeremykenedy\LaravelToast\Support\ToastSettings"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml">
        <exclude name="TooManyMethods"/>
        <exclude name="TooManyPublicMethods"/>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <properties>
            <property name="maxmethods" value="15"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyPublicMethods">
        <properties>
            <property name="maxmethods" value="15"/>
        </properties>
    </rule>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="exceptions" value="id"/>
        </properties>
    </rule>
    <rule ref="rulesets/unusedcode.xml">
        <exclude name="UnusedFormalParameter"/>
    </rule>
    <rule ref="rulesets/unusedcode.xml/UnusedFormalParameter">
        <exclude-pattern>*/tests/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
